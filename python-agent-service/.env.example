# Python 多 Agent 服务的 LLM 配置（python-agent-service/.env）
# 由 app/config.py 通过 python-dotenv 加载（在 python-agent-service 目录下运行服务时生效）。

# 是否启用真实 LLM；设为 false 则全部退回规则实现（无需 Ollama）。
LLM_ENABLED=true

# OpenAI 兼容端点，默认指向本地 Ollama 的 /v1；可改为 DeepSeek / OpenAI 等。
LLM_BASE_URL=http://localhost:11434/v1

# 模型名，需与 `ollama pull` 的模型一致。
LLM_MODEL=qwen2.5:latest

# Ollama 无需真实 key，填任意值即可；其它提供方填对应 key。
LLM_API_KEY=ollama

# 生成温度
LLM_TEMPERATURE=0.3

# 单次 LLM 调用超时（毫秒）
LLM_TIMEOUT_MS=30000
