# Python 多 Agent 服务的 LLM 配置（python-agent-service/.env）
# 由 app/config.py 通过 python-dotenv 加载（在 python-agent-service 目录下运行服务时生效）。

# 是否启用真实 LLM；设为 false 则全部退回规则实现（无需 Ollama）。
LLM_ENABLED=true

# OpenAI 兼容端点，默认指向本地 Ollama 的 /v1；可改为 DeepSeek / OpenAI 等。
LLM_BASE_URL=http://localhost:11434/v1

# 模型名，需与 `ollama pull` 的模型一致。
LLM_MODEL=qwen2.5:latest

# Ollama 无需真实 key，填任意值即可；其它提供方填对应 key。
LLM_API_KEY=ollama

# 生成温度
LLM_TEMPERATURE=0.3

# 单次 LLM 调用超时（毫秒）
LLM_TIMEOUT_MS=30000

# ===== 分类知识库 RAG（可选）=====
# 关闭后 Agent 行为与改造前完全一致（不检索知识库）。
RAG_ENABLED=true
# 知识库目录（相对 python-agent-service/，或绝对路径）。目录下每个 <Category>.md 即一个类目。
RAG_KNOWLEDGE_DIR=knowledge
# 本地 embedding 模型，需先 `ollama pull nomic-embed-text`。
RAG_EMBEDDING_MODEL=nomic-embed-text
# embeddings 端点，默认复用 LLM 的 Ollama /v1。
RAG_EMBEDDING_BASE_URL=http://localhost:11434/v1
# 每类召回块数
RAG_TOP_K=3
# 切块参数（可选）
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50

# ===== 通义万相（DashScope）文生图（可选）=====
# 用同一个 DashScope API Key 调用 wanx-v1 生成真实商品图（需安装 dashscope SDK）。
# 留空或设为 false 时，图片步骤只出提示词占位，不阻断上架链路。
DASHSCOPE_API_KEY=
IMAGE_GEN_ENABLED=false
