POSTGRES_DB=ecommerce_agent
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=ecommerce_password
POSTGRES_PORT=5432

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/ecommerce_agent

# 订单数据来源（部署开关，Java 侧读取）：
#   mock —— 本地模拟造数（默认）。链路与真实拉单完全一致，仅数据是生成的，用于演示/试用。
#   real —— 经 Python 平台适配器拉取真实订单；先在「设置中心 → 平台对接」填好各平台凭证再切换。
# DATA_SOURCE=mock

# 鉴权（Java 与 Python 共用）：
#   JWT_SECRET      —— HS256 密钥，Java 签发 / Python 校验用户 JWT（浏览器 Bearer）
#   SERVICE_API_KEY —— 服务间密钥，Python<->Java 双向闭环内部调用携带 X-Service-Key 头
# 本地演示可用默认值；生产务必改为强随机值，且 Java 与 Python 两处保持一致。
# JWT_SECRET=dev-jwt-secret-change-me
# SERVICE_API_KEY=dev-service-key-change-me

# Python 多 Agent 服务的 LLM 配置：完整示例见 python-agent-service/.env.example
# LLM_ENABLED=true
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:latest
# LLM_API_KEY=ollama
# LLM_TEMPERATURE=0.3
# LLM_TIMEOUT_MS=30000

# 订单监控 Agent（OrderMonitorAgent，Python 侧）已改为模式无关：不再区分 demo/real，
# 始终经 PlatformAdapter.get_address_complete 复核地址——未配凭证返回模拟器同构真相，配了查真实开放 API。
# 因此不再有 ORDER_MONITOR_MODE / ORDER_MONITOR_DEMO_SUCCESS_RATE 配置（已移除）。

# 地址补全定时轮询（Java 侧）：自动回写平台 address_complete 真相，免去逐单手动点「确认地址已补全」。
# 走 PlatformAdapter：未配置真实凭证时返回模拟器同构真相，接上官方 API 即直接生效（模式无关）。
#   ORDER_ADDRESS_SYNC_ENABLED —— 是否开启轮询（默认 true）
#   ORDER_ADDRESS_SYNC_DELAY_MS  —— 每轮间隔毫秒（默认 60000）
#   ORDER_ADDRESS_SYNC_BATCH     —— 每轮最多处理的待处理订单数（默认 50）
#   ORDER_ADDRESS_SYNC_SLA_DAYS  —— 地址未补全超过该天数仍未处理 → 自动升级为「需人工审核」（默认 7）
# ORDER_ADDRESS_SYNC_ENABLED=true
# ORDER_ADDRESS_SYNC_DELAY_MS=60000
# ORDER_ADDRESS_SYNC_BATCH=50
# ORDER_ADDRESS_SYNC_SLA_DAYS=7
