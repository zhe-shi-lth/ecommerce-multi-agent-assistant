POSTGRES_DB=ecommerce_agent
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=ecommerce_password
POSTGRES_PORT=5432

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/ecommerce_agent

# 订单数据来源（部署开关，Java 侧读取）：
#   mock —— 本地模拟造数（默认）。链路与真实拉单完全一致，仅数据是生成的，用于演示/试用。
#   real —— 经 Python 平台适配器拉取真实订单；先在「设置中心 → 平台对接」填好各平台凭证再切换。
# DATA_SOURCE=mock

# 鉴权（Java 与 Python 共用）：
#   JWT_SECRET      —— HS256 密钥，Java 签发 / Python 校验用户 JWT（浏览器 Bearer）
#   SERVICE_API_KEY —— 服务间密钥，Python<->Java 双向闭环内部调用携带 X-Service-Key 头
# 本地演示可用默认值；生产务必改为强随机值，且 Java 与 Python 两处保持一致。
# JWT_SECRET=dev-jwt-secret-change-me
# SERVICE_API_KEY=dev-service-key-change-me

# Python 多 Agent 服务的 LLM 配置：完整示例见 python-agent-service/.env.example
# LLM_ENABLED=true
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:latest
# LLM_API_KEY=ollama
# LLM_TEMPERATURE=0.3
# LLM_TIMEOUT_MS=30000

# 订单监控 Agent（OrderMonitorAgent，Python 侧）：商家点「确认地址已补全」时由该 Agent 向订单来源复核。
#   ORDER_MONITOR_MODE = demo  → 随机模拟平台同步复核（通过/拦截各约一半），仅用于本地演示与分支演练。
#   ORDER_MONITOR_MODE = real  → 生产态，须由 OrderMonitorAgent._verify_real 接入平台开放 API（读取 address_complete）。
# ⚠️ 上生产前必须将 mode 置为 real 并去除演示态随机逻辑。
# ORDER_MONITOR_MODE=demo
# ORDER_MONITOR_DEMO_SUCCESS_RATE=0.5
